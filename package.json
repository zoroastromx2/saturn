    "prettier": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-glsl": "^1.6.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@google/genai": "^3.3.0",
    "express": "^5.3.0",
